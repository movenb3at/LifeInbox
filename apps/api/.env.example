# Supabase Dashboard > Connect > Session pooler (IPv4, port 5432).
# Runtime connects as lifeinbox_app.PROJECT_REF, NOT postgres.
DATABASE_URL=postgresql+psycopg://lifeinbox_app.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Used by setup / Alembic only. Never passed to the running API.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
APP_TIMEZONE=Asia/Seoul
