{
  "name": "@lifeinbox/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:ocr": "node ../../scripts/prepare-ocr-assets.mjs",
    "dev": "pnpm prepare:ocr && next dev --hostname 127.0.0.1",
    "build": "pnpm prepare:ocr && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "generate:api": "openapi-typescript ../../docs/openapi.json -o src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
